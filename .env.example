# Copy to .env.local for local runs; set the same variables in Vercel (Project Settings > Environment Variables).
# Never commit real values.

# Shown on the website
STUDENT_NAME=
TELEGRAM_BOT_USERNAME=
GITHUB_REPO_URL=

# Supabase: Project Settings > API. The service role key stays server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram: token from @BotFather. Secret: any random string (A-Z, a-z, 0-9, _ and -).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Google Sheets: service account from the JSON key file; sheet ID from the spreadsheet URL.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=
